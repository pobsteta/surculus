<?xml version="1.0" encoding="utf-8"?>
<!-- ADR 0005 : ni sauvegarde dans le nuage Google, ni transfert d'appareil à appareil (Android 12 et plus).
     La sauvegarde de Surculus est le .sursync, sous Documents/Surculus/. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
